// German-adapted ZMK keymap for Totem V3
// NOTE: This is a template adapting your BASE layer to German QWERTZ
//       and adding German Umlauts (Ä Ö Ü ß). Adjust MT/MO behaviors
//       to your preference.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE (DE QWERTZ)";
            bindings = <
                // Row 1
                &kp Q  &kp W  &kp E  &kp R  &kp T      &kp Z  &lt SYM &kp UE  &kp I  &lt SYM &kp OE  &kp P
                // Row 2
                &lt SYM &kp AE  &lt SYM &kp SS  &kp D  &kp F  &kp G      &kp H  &kp J  &kp K  &kp L  &kp SEMICOLON
                // Row 3
                &kp Y  &kp X  &kp C  &kp V  &kp B      &kp N  &kp M  &kp COMMA  &kp DOT  &kp MINUS
                // Thumbs
                &kp DELETE  &kp TAB  &kp SPACE   &kp ENTER  &kp BSPC
            >;
        };

        nav_layer {
            label = "NAV (unchanged)";
            bindings = <
                &trans &trans &kp UP &trans &trans   &trans &trans &kp N8 &kp N9 &trans
                &trans &kp LEFT_ARROW &kp DOWN_ARROW &kp RIGHT_ARROW &trans  &trans &kp N4 &kp N5 &kp N6 &trans
                &trans &trans &kp PG_UP &trans &kp PG_DN  &trans &kp N1 &kp N2 &kp N3 &trans &trans &trans
                &trans &trans &trans &trans &trans   &kp N0 &trans
            >;
        };

        sym_layer {
            label = "SYM (DE symbols + Umlaute + refined brackets)";
            bindings = <
                // Row 1 — () and punctuation
                &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT    &kp LPAREN &kp RPAREN &kp CARET &kp AMPS &kp EQUAL

                // Row 2 — [] and Umlaute
                &kp AE &kp OE &kp UE &kp SS &trans             &kp LBRACKET &kp RBRACKET &kp STAR &kp PLUS &kp BSLH

                // Row 3 — {} and extended symbols
                &kp TILDE &kp GRAVE &kp LCBR &kp RCBR &kp PIPE   &kp LT &kp GT &kp SEMICOLON &kp COLON &trans

                // Thumbs — leave mostly neutral
                &trans &trans &trans    &trans &trans
            >;
        };

        adjust_layer {
            label = "ADJ (unchanged)";
            bindings = <
                &sys_reset &bt BT_CLR &out OUT_TOG &trans &trans   &trans &kp F7 &kp F8 &kp F9 &kp F12
                &bootloader &bt BT_NXT &trans &trans &trans  &trans &kp F4 &kp F5 &kp F6 &kp F11
                &trans &trans &bt BT_PRV &trans &trans  &trans &kp F1 &kp F2 &kp F3 &kp F10 &trans
                &trans &trans &trans &trans &trans &trans
            >;
        };
    };
};
